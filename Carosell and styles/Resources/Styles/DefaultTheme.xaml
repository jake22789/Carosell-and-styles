<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Carosell_and_styles.Resources.Styles.DefaultTheme">

    <Color x:Key="PageBackground">#FFFFFF</Color>
    <Color x:Key="PrimaryText">#222222</Color>
    <Color x:Key="AccentColor">#512BD4</Color>

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource PageBackground}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{DynamicResource PrimaryText}" />
    </Style>

</ResourceDictionary>